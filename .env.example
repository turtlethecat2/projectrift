# Copy to `.env` and edit. Generate WEBHOOK_SECRET:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

DB_HOST=localhost
DB_PORT=5432
DB_NAME=project_rift
DB_USER=rift_user
DB_PASSWORD=rift_password
DATABASE_URL=postgresql://rift_user:rift_password@localhost:5432/project_rift

WEBHOOK_SECRET=PASTE_A_RANDOM_STRING_AT_LEAST_32_CHARS_LONG

API_HOST=0.0.0.0
API_PORT=8000

ENVIRONMENT=development
LOG_LEVEL=INFO
SOUND_VOLUME=0.7

HUD_REFRESH_INTERVAL=5
HUD_OPACITY=0.85

DBT_PROFILES_DIR=./dbt_project
DBT_TARGET=dev

RATE_LIMIT_PER_MINUTE=60

# Optional — Outreach OAuth (leave placeholders to disable scheduler + OAuth routes)
OUTREACH_CLIENT_ID=
OUTREACH_CLIENT_SECRET=
OUTREACH_REDIRECT_URI=

OUTREACH_POLL_INTERVAL_MINUTES=15
